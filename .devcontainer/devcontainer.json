{
  // Named after the workspace folder, so this file needs no edit when the base is reused.
  "name": "${localWorkspaceFolderBasename}",
  // Base image + one fix; see .devcontainer/Dockerfile (path is relative to this folder).
  "build": { "dockerfile": "Dockerfile" },

  "features": {
    "ghcr.io/devcontainers/features/aws-cli:1": { },
    "ghcr.io/devcontainers/features/github-cli:1": { },
    // Its own Docker daemon inside the container: builds images and runs compose.yaml.
    // Isolated from the host's Docker, so other containers on the machine stay out of reach.
    // Images are cached per project; free space with `docker system prune -a`.
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": { },
    // Claude Code CLI + the VS Code extension (the feature adds both)
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": { }
  },
  // Runs on the host before the build: creates the mounted folders (the container won't start without
  // them) and the git-ignored PROJECT_CONTEXT.md from its template.
  "initializeCommand": "sh .devcontainer/initialize.sh ${localWorkspaceFolderBasename}",
  "mounts": [
    // A dedicated AWS config folder on the host, not ~/.aws.
    // Only these credentials are visible inside the container.
    "source=${localEnv:HOME}/.aws-sandbox,target=/home/vscode/.aws,type=bind",
    // Claude Code login, settings and history survive container rebuilds
    "source=${localEnv:HOME}/.claude-projects/${localWorkspaceFolderBasename},target=/home/vscode/.claude,type=bind",
    // GitHub CLI login survives container rebuilds too
    "source=gh-config-${devcontainerId},target=/home/vscode/.config/gh,type=volume",
    // pre-commit hook environments: kept across rebuilds, so the first commit doesn't reinstall them
    "source=pre-commit-cache-${devcontainerId},target=/home/vscode/.cache/pre-commit,type=volume"
  ],

  "containerEnv": {
    "AWS_PROFILE": "sandbox",
    "AWS_REGION": "eu-central-1",
    "AWS_DEFAULT_REGION": "eu-central-1",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    // Claude Code: no usage telemetry, no error reports. Auto-updates stay on for security fixes.
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },

  // Virtualenv outside the bind-mounted workspace, so a host .venv can't collide with it.
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteEnv": {
    // ~/.local/bin holds uv (post-create.sh): VS Code extensions need it too, not just the shell.
    "PATH": "/home/vscode/.venv/bin:/home/vscode/.local/bin:${containerEnv:PATH}",
    "VIRTUAL_ENV": "/home/vscode/.venv",
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        // Python
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        // Config files
        "redhat.vscode-yaml",
        "editorconfig.editorconfig",
        "davidanson.vscode-markdownlint",
        // Containers, CI
        "ms-azuretools.vscode-containers",
        "github.vscode-github-actions",
        // Editor
        "usernamehw.errorlens",
        "anthropic.claude-code"
      ]
      // Editor settings live in .vscode/settings.json.
    }
  },

  "remoteUser": "vscode"
}
