# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# Variables already set in the shell win.

# bedrock (default) or openrouter
MODEL_PROVIDER=bedrock
MODEL_ID=eu.amazon.nova-2-lite-v1:0

# Only when MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=

# Local Postgres from compose.yaml
DATABASE_URL=postgresql://app:app@localhost:5432/app

# SEC EDGAR User-Agent: client name and contact email, e.g. "company-research-engine you@example.com"
SEC_USER_AGENT=

# Embedding model on OpenRouter (uses OPENROUTER_API_KEY), e.g. nvidia/nemotron-3.5-embed-1b:free
EMBEDDING_MODEL_ID=

# AgentCore deployment only (set by infra/ on the runtime; leave empty locally).
# Secrets Manager secret (JSON) holding OPENROUTER_API_KEY and SUPABASE_DATABASE_URL
APP_SECRET_ID=
# Aurora cluster and its credential secret: when set, the filings database is reached through the RDS Data API
DB_CLUSTER_ARN=
DB_SECRET_ARN=
DB_NAME=
# Supabase connection string (checked for reachability at startup only)
SUPABASE_DATABASE_URL=
